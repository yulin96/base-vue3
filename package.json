  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "run-p type-check lint",
    "build": "run-p type-check \"build:only {@}\" --",
    "build:deploy": "run-p check \"deploy:prod {@}\" --",
    "build:deploy:test": "run-p check \"deploy:test {@}\" --",
    "preview": "vite preview",
    "build:only": "vite build",
    "deploy:prod": "vite build --mode deploy",
    "deploy:test": "vite build --mode deploy-test",
    "type-check": "vue-tsc --build",
    "lint": "oxlint && eslint src --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "oxlint --fix && eslint src --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "oxfmt"
  },
