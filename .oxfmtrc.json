{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "jsxSingleQuote": true,
  "printWidth": 120,
  "quoteProps": "as-needed",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "./src/assets/styles/tailwind.css",
    "functions": ["clsx", "cn", "cva"]
  },
  "ignorePatterns": [
    "src/utils/animation/lotties/*.json",
    "src/**/*.svg",
    "types/**/*.d.ts",
    "pnpm-lock.yaml",
    "node_modules",
    "dist",
    "dist-ssr"
  ]
}
